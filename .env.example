# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SITE_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/backyardconnect.sqlite
TRUST_PROXY=false

# Required in production. Run: npm run generate-secrets
SESSION_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
HASH_SECRET=replace-with-a-separate-long-random-secret

# Admin account. Run: npm run hash-password -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=8

# Public contact details. Empty values are hidden.
PUBLIC_CONTACT_EMAIL=hello@backyardconnect.co.za
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_BUSINESS_HOURS=Monday to Friday, 08:00–17:00

# Optional server-to-server notification sent after a referral is saved.
REFERRAL_WEBHOOK_URL=
REFERRAL_WEBHOOK_SECRET=

# Public rate limiting
REFERRAL_RATE_LIMIT=8
REFERRAL_RATE_WINDOW_MINUTES=60

# Retention
SESSION_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=2190
